---
import { Target, Zap, ShieldCheck, Languages } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const items = [
  { icon: Target, title: t('principles.focus.title'), body: t('principles.focus.body') },
  { icon: Zap, title: t('principles.fast.title'), body: t('principles.fast.body') },
  { icon: ShieldCheck, title: t('principles.private.title'), body: t('principles.private.body') },
  { icon: Languages, title: t('principles.multilingual.title'), body: t('principles.multilingual.body') },
];
---

<section id="philosophy" class="border-y border-border bg-card/50 py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={t('principles.eyebrow')} title={t('principles.title')} subtitle={t('principles.subtitle')} />

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map(({ icon: Icon, title, body }, i) => (
          <li class="card-surface p-6" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
              <Icon class="size-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-lg font-bold tracking-tight">{title}</h3>
            <p class="mt-2 text-sm text-muted-fg">{body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

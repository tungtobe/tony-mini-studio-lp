---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-5 text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg text-muted-fg">{subtitle}</p>}
</div>
